# ---------------------------------------------------------------------------
# NOVA configuration
# Copy to .env  ->  cp .env.example .env
# Defaults below run the platform 100% locally: no Azure, no paid APIs.
# ---------------------------------------------------------------------------

# There is no APP_MODE variable. The overall mode shown in the UI is DERIVED
# from the provider modes below. Setting APP_MODE is rejected at startup.

# Provider modes. Each one is independent and never auto-detected.
# local | azure
AI_MODE=local
# local | azure
KNOWLEDGE_MODE=local
# demo  | entra
AUTH_MODE=demo
# local | azure
ACTION_MODE=local
# local | azure_search
VECTOR_STORE=local

# Server
PORT=4317
HOST=127.0.0.1
LOG_LEVEL=info

# Local persistence (SQLite + local blob storage on disk)
DATABASE_URL=file:./data/nova.db
STORAGE_DIR=./data/storage
SEED_KNOWLEDGE_DIR=./knowledge

# Demo auth (LOCAL ONLY - not a real authentication system)
DEMO_SESSION_SECRET=local-dev-only-change-me

# ---------------------------------------------------------------------------
# Local AI
# Optional: point NOVA at any OpenAI-compatible local server
# (Ollama: http://localhost:11434/v1 , llama.cpp, LM Studio, vLLM, ...).
# If LOCAL_LLM_BASE_URL is empty, NOVA uses the built-in deterministic
# extractive fallback composer and clearly labels answers as FALLBACK.
# ---------------------------------------------------------------------------
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_MS=60000

# Optional local embedding server (OpenAI-compatible /embeddings).
# If empty, NOVA uses the built-in deterministic hashed-lexical embedder.
LOCAL_EMBEDDING_BASE_URL=
LOCAL_EMBEDDING_MODEL=nova-hashed-lexical-v1
EMBEDDING_DIM=384

# Retrieval tuning
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_KEYWORD_WEIGHT=0.4
CHUNK_TARGET_CHARS=1100
CHUNK_OVERLAP_CHARS=150

# ---------------------------------------------------------------------------
# AZURE / MICROSOFT FOUNDRY  ---  DISABLED BY DEFAULT
# Nothing below is read while AI_MODE/KNOWLEDGE_MODE/AUTH_MODE are local/demo.
# See docs/azure-integration.md before enabling.
# ---------------------------------------------------------------------------
# Set AI_MODE=azure above to activate the Foundry providers.
#
# Microsoft Foundry project (values below are the real NOVA project; the
# project name is lowercase nova-foundry and must not be capitalised).
# The OpenAI-compatible route NOVA calls is <FOUNDRY_ENDPOINT>/openai/v1,
# and the DEPLOYMENT NAME is sent as the `model` field in the request body.
# The v1 route takes no api-version query parameter.
#
# FOUNDRY_MODEL_DEPLOYMENT is nova-chat: GPT-4.1-mini, Global Standard.
# AZURE_EMBEDDING_DEPLOYMENT is nova-embedding: text-embedding-3-small,
# Global Standard.
FOUNDRY_PROJECT=nova-foundry
FOUNDRY_ENDPOINT=https://nova-foundry-hn-2376.services.ai.azure.com/api/projects/nova-foundry
FOUNDRY_MODEL_DEPLOYMENT=nova-chat
AZURE_EMBEDDING_DEPLOYMENT=nova-embedding
FOUNDRY_AGENT_ID=

# KNOWLEDGE_MODE=azure
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=
AZURE_SEARCH_API_VERSION=2024-07-01
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=

# AUTH_MODE=entra
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
ENTRA_AUDIENCE=

# Credentials for Azure data-plane calls (or use managed identity / az login).
# BACKEND-ONLY SECRET. Never commit a real value, never expose it to the
# frontend. Preferred production path is Entra ID (scope
# https://ai.azure.com/.default) instead of a static key.
AZURE_API_KEY=

# Observability (optional, Azure only)
APPLICATIONINSIGHTS_CONNECTION_STRING=
